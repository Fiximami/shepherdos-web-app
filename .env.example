# FaithBaseOS web app — API and deployment configuration

# Backend API (Render today; api.faithbaseos.com later)
NEXT_PUBLIC_API_BASE_URL=https://shepherdos-api.onrender.com

# Optional default church slug used to prefill sign-in
NEXT_PUBLIC_CHURCH_SLUG=

# Product branding (defaults to FaithBaseOS)
NEXT_PUBLIC_PRODUCT_NAME=FaithBaseOS
NEXT_PUBLIC_PRODUCT_TAGLINE=Church operations, cared for well.
NEXT_PUBLIC_APP_URL=https://app.faithbaseos.com

# Alpha / production hardening
# When true (default), only alpha-safe routes appear in navigation and direct URLs redirect.
NEXT_PUBLIC_ALPHA_MODE=true

# Show all preview routes in nav and allow direct access (local development)
NEXT_PUBLIC_SHOW_PREVIEW_ROUTES=false

# Demo dashboard on login — defaults to true in development, false in production builds
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Password reset pages — disabled until backend endpoints are live
NEXT_PUBLIC_ENABLE_PASSWORD_RESET=false
